{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/cit/csm_schema.json",
  "title": "Configuration Space Model (CSM)",
  "description": "Machine-readable configuration space model for combinatorial interaction testing (CIT) of a configurable system. Options carry a binding time, a finite set of test settings (equivalence partitions / boundary values for ranged options), a default, and source evidence. Constraints are formal boolean formulas over option settings; any configuration for which a 'hard' constraint evaluates to false is invalid and must not be built.",
  "type": "object",
  "required": ["csm_version", "system", "options", "constraints"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "csm_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "system": { "$ref": "#/$defs/system" },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/option" }
    },
    "constraints": {
      "type": "array",
      "items": { "$ref": "#/$defs/constraint" }
    },
    "excluded_options": {
      "description": "Variability points found during extraction but deliberately left out of the model, with the reason. Keeps the extraction auditable.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["option_name", "reason"],
        "additionalProperties": false,
        "properties": {
          "option_name": { "type": "string" },
          "reason": { "type": "string" },
          "source_location": { "type": "array", "items": { "$ref": "#/$defs/sourceLocation" } }
        }
      }
    },
    "build": { "$ref": "#/$defs/build" },
    "test_suite": { "$ref": "#/$defs/testSuite" }
  },

  "$defs": {
    "scalar": {
      "description": "An option value. Booleans are encoded as 0/1 integers to match C preprocessor semantics.",
      "type": ["integer", "number", "string"]
    },

    "sourceLocation": {
      "type": "object",
      "required": ["file", "kind"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string", "description": "Path relative to the subject system root." },
        "lines": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "description": "1-based line numbers at the pinned commit."
        },
        "kind": {
          "enum": ["definition", "use", "documentation", "build_system", "test"]
        },
        "note": { "type": "string" }
      }
    },

    "setting": {
      "type": "object",
      "required": ["value"],
      "additionalProperties": false,
      "properties": {
        "value": { "$ref": "#/$defs/scalar" },
        "label": { "type": "string", "description": "Short partition name, e.g. 'min-boundary', 'default'." },
        "rationale": { "type": "string" }
      }
    },

    "encoding": {
      "description": "How a chosen setting is applied. 'c_macro' => passed as -D<macro>=<value> and requires a rebuild. 'driver_cli' => passed to the test driver at run time as '<flag> <value>' (no rebuild).",
      "type": "object",
      "required": ["mechanism"],
      "additionalProperties": false,
      "properties": {
        "mechanism": { "enum": ["c_macro", "driver_cli", "env_var", "config_file"] },
        "macro": { "type": "string" },
        "value_format": {
          "enum": ["int", "bool01", "c_string_literal", "raw"],
          "description": "For c_macro: how the value is rendered after '='. c_string_literal wraps the value in double quotes with C escaping."
        },
        "flag": { "type": "string" },
        "variable": { "type": "string" }
      }
    },

    "option": {
      "type": "object",
      "required": [
        "option_name", "binding_time", "domain_type", "discrete_settings",
        "default_value", "source_location", "encoding", "description"
      ],
      "additionalProperties": false,
      "properties": {
        "option_name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "binding_time": {
          "enum": ["compile_time", "runtime"],
          "description": "compile_time: changing it requires a rebuild (#if / -D). runtime: set without rebuilding (API argument, struct field, CLI flag, config value)."
        },
        "description": { "type": "string" },
        "domain_type": {
          "enum": ["boolean", "enum", "integer", "string"],
          "description": "Underlying domain. 'integer' and 'string' domains are open and MUST be discretized (see discretization_rationale)."
        },
        "discrete_settings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/setting" },
          "description": "The finite set of values used for test generation. Must include the default."
        },
        "valid_range": {
          "description": "For integer domains: the full legal range (inclusive). Values in range but not in discrete_settings are legal but 'off-partition'.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": { "type": "integer" },
            "max": { "type": "integer" },
            "evidence": { "type": "string" }
          }
        },
        "discretization_rationale": { "type": "string" },
        "default_value": { "$ref": "#/$defs/scalar" },
        "source_location": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceLocation" }
        },
        "encoding": { "$ref": "#/$defs/encoding" },
        "active_when": {
          "$ref": "#/$defs/condition",
          "description": "Option only influences the system when this condition holds; otherwise it is inert ('don't care') and can be collapsed to its default without changing the built artifact."
        },
        "build_system_alias": { "type": "string", "description": "Equivalent option in the project's own build system, if any." }
      },
      "allOf": [
        {
          "if": { "properties": { "domain_type": { "enum": ["integer", "string"] } } },
          "then": { "required": ["discretization_rationale"] }
        },
        {
          "if": { "properties": { "domain_type": { "const": "integer" } } },
          "then": { "required": ["valid_range"] }
        },
        {
          "if": { "properties": { "binding_time": { "const": "compile_time" } } },
          "then": {
            "properties": {
              "encoding": {
                "properties": { "mechanism": { "const": "c_macro" } },
                "required": ["macro", "value_format"]
              }
            }
          }
        },
        {
          "if": { "properties": { "binding_time": { "const": "runtime" } } },
          "then": {
            "properties": {
              "encoding": {
                "properties": { "mechanism": { "enum": ["driver_cli", "env_var", "config_file"] } }
              }
            }
          }
        }
      ]
    },

    "condition": {
      "description": "Boolean formula over option settings. Atoms compare an option with a literal ('value'), a list ('values', for in/not_in) or another option ('ref').",
      "oneOf": [
        {
          "type": "object",
          "required": ["option", "op"],
          "additionalProperties": false,
          "properties": {
            "option": { "type": "string" },
            "op": { "enum": ["==", "!=", "<", "<=", ">", ">=", "in", "not_in"] },
            "value": { "$ref": "#/$defs/scalar" },
            "values": { "type": "array", "items": { "$ref": "#/$defs/scalar" } },
            "ref": { "type": "string" }
          }
        },
        {
          "type": "object", "required": ["all"], "additionalProperties": false,
          "properties": { "all": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } } }
        },
        {
          "type": "object", "required": ["any"], "additionalProperties": false,
          "properties": { "any": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } } }
        },
        {
          "type": "object", "required": ["not"], "additionalProperties": false,
          "properties": { "not": { "$ref": "#/$defs/condition" } }
        },
        {
          "type": "object", "required": ["implies"], "additionalProperties": false,
          "properties": {
            "implies": {
              "type": "array", "minItems": 2, "maxItems": 2,
              "items": { "$ref": "#/$defs/condition" },
              "description": "[antecedent, consequent]"
            }
          }
        },
        { "type": "boolean" }
      ]
    },

    "constraint": {
      "type": "object",
      "required": ["id", "severity", "expression", "rationale", "evidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "severity": {
          "enum": ["hard", "soft"],
          "description": "hard: configurations violating it are invalid (build/link failure, undefined behaviour, or explicitly forbidden by the documented contract). soft: legal but semantically contradictory; reported as a warning."
        },
        "expression": {
          "type": "string",
          "description": "Human-readable formal constraint in the CSM expression language: 'if <cond> then <cond>' or '<cond>', with and/or/not, parentheses and comparisons ==, !=, <, <=, >, >=, in [..], not in [..]. Identifiers are option names; string literals use double quotes."
        },
        "formula": {
          "$ref": "#/$defs/condition",
          "description": "Optional pre-parsed form of 'expression'. When present, tools use it and self-checks verify it agrees with 'expression'."
        },
        "rationale": { "type": "string" },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceLocation" } }
      }
    },

    "system": {
      "type": "object",
      "required": ["name", "repository", "commit", "language"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "repository": { "type": "string" },
        "commit": { "type": "string" },
        "commit_date": { "type": "string" },
        "language": { "type": "string" },
        "local_path": { "type": "string", "description": "Path of the checkout, relative to the workspace directory." },
        "sut_sources": { "type": "array", "items": { "type": "string" } },
        "extraction": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "date": { "type": "string" },
            "method": { "type": "string" },
            "artifacts_inspected": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },

    "build": {
      "type": "object",
      "required": ["compiler", "library_sources"],
      "additionalProperties": false,
      "properties": {
        "compiler": { "type": "string" },
        "library_sources": { "type": "array", "items": { "type": "string" } },
        "include_dirs": { "type": "array", "items": { "type": "string" } },
        "cflags": { "type": "array", "items": { "type": "string" } },
        "coverage_cflags": { "type": "array", "items": { "type": "string" } },
        "sanitizer_cflags": { "type": "array", "items": { "type": "string" } },
        "coverage_sources": {
          "type": "array", "items": { "type": "string" },
          "description": "Files whose coverage is reported (the system under test, not the test drivers)."
        }
      }
    },

    "testSuite": {
      "type": "object",
      "required": ["drivers", "variants"],
      "additionalProperties": false,
      "properties": {
        "oracle": { "type": "string" },
        "working_directory": { "type": "string" },
        "input_files": { "type": "array", "items": { "type": "string" } },
        "case_delimiter_regex": {
          "type": "string",
          "description": "Regex matching the line that closes one test case in driver output; used to split output into per-case verdicts."
        },
        "drivers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "source", "origin"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "source": { "type": "string" },
              "origin": { "enum": ["developer", "generated"] },
              "fixed_runtime": {
                "type": "object",
                "description": "Runtime option values hard-wired into this driver.",
                "additionalProperties": { "$ref": "#/$defs/scalar" }
              },
              "accepts_runtime_options": { "type": "boolean" },
              "compatible_when": { "$ref": "#/$defs/condition" },
              "extra_link_sources_when": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["when", "sources"],
                  "additionalProperties": false,
                  "properties": {
                    "when": { "$ref": "#/$defs/condition" },
                    "sources": { "type": "array", "items": { "type": "string" } }
                  }
                }
              },
              "args": { "type": "array", "items": { "type": "string" } },
              "baseline_proxy_for": {
                "type": "string",
                "description": "Id of a developer driver whose golden baselines also apply to this driver's output."
              },
              "baseline_valid_when": {
                "$ref": "#/$defs/condition",
                "description": "Condition (typically over runtime options) under which the proxied baselines are a valid oracle."
              },
              "notes": { "type": "string" }
            }
          }
        },
        "variants": {
          "description": "Developer test variants: a driver built with specific compile-time settings and checked against a golden baseline.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "driver", "settings", "baseline"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "driver": { "type": "string" },
              "settings": {
                "type": "object",
                "additionalProperties": { "$ref": "#/$defs/scalar" },
                "description": "Compile-time option settings (others at default)."
              },
              "baseline": { "type": "string" },
              "source_location": { "type": "array", "items": { "$ref": "#/$defs/sourceLocation" } }
            }
          }
        }
      }
    }
  }
}
