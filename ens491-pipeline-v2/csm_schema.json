{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/cit/csm_schema_v2.json",
  "title": "Configuration Space Model (CSM) v2",
  "description": "Human-authored (YAML) and machine-consumed (JSON) model of a configurable system for combinatorial interaction testing. Every option has a binding time, a value domain, a default, a finite set of generation settings (enum/boolean values or integer partition representatives), evidence in the sources and discovery provenance. Constraints are boolean formulas in the CSM expression language; 'hard' constraints define validity, 'soft' ones flag legal-but-contradictory combinations.",
  "type": "object",
  "required": ["csm_version", "system", "options", "constraints"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "csm_version": { "type": "string", "pattern": "^2\\.[0-9]+$" },
    "system": { "$ref": "#/$defs/system" },
    "options": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/option" } },
    "constraints": { "type": "array", "items": { "$ref": "#/$defs/constraint" } },
    "interaction_groups": { "type": "array", "items": { "$ref": "#/$defs/interactionGroup" } },
    "excluded_options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["option_name", "reason"],
        "additionalProperties": false,
        "properties": {
          "option_name": { "type": "string" },
          "reason": { "type": "string" },
          "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
          "provenance": { "$ref": "#/$defs/provenance" }
        }
      }
    },
    "build": { "$ref": "#/$defs/build" },
    "test_suite": { "$ref": "#/$defs/testSuite" }
  },

  "$defs": {
    "scalar": { "type": ["integer", "number", "string"] },

    "expression": {
      "description": "CSM expression language text, e.g. 'if A == 1 and B != \"x\" then C <= D'. Parsed by csm_model.parse_expression.",
      "type": "string",
      "minLength": 1
    },

    "condition": {
      "description": "Either expression text or a pre-parsed condition tree.",
      "oneOf": [
        { "$ref": "#/$defs/expression" },
        { "$ref": "#/$defs/conditionTree" }
      ]
    },

    "conditionTree": {
      "oneOf": [
        {
          "type": "object", "required": ["option", "op"], "additionalProperties": false,
          "properties": {
            "option": { "type": "string" },
            "op": { "enum": ["==", "!=", "<", "<=", ">", ">=", "in", "not_in"] },
            "value": { "$ref": "#/$defs/scalar" },
            "values": { "type": "array", "items": { "$ref": "#/$defs/scalar" } },
            "ref": { "type": "string" }
          }
        },
        { "type": "object", "required": ["all"], "additionalProperties": false,
          "properties": { "all": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/conditionTree" } } } },
        { "type": "object", "required": ["any"], "additionalProperties": false,
          "properties": { "any": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/conditionTree" } } } },
        { "type": "object", "required": ["not"], "additionalProperties": false,
          "properties": { "not": { "$ref": "#/$defs/conditionTree" } } },
        { "type": "object", "required": ["implies"], "additionalProperties": false,
          "properties": { "implies": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/conditionTree" } } } },
        { "type": "boolean" }
      ]
    },

    "lineSpec": {
      "description": "1-based lines at the pinned commit: an integer, or a string such as '138-142,146'.",
      "oneOf": [
        { "type": "integer", "minimum": 1 },
        { "type": "string", "pattern": "^\\s*[0-9]+(\\s*-\\s*[0-9]+)?(\\s*,\\s*[0-9]+(\\s*-\\s*[0-9]+)?)*\\s*$" }
      ]
    },

    "evidence": {
      "type": "object",
      "required": ["file", "kind"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string", "description": "Path relative to the subject checkout." },
        "lines": { "$ref": "#/$defs/lineSpec" },
        "kind": { "enum": ["definition", "use", "documentation", "build_system", "test", "empirical"] },
        "note": { "type": "string" }
      }
    },

    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "discovered_by": { "type": "array", "items": { "enum": ["static", "llm", "human", "empirical"] },
                           "description": "Every stage that proposed this element (union after merge)." },
        "model": { "type": ["string", "null"], "description": "LLM identifier when an LLM proposed it." },
        "stages": { "type": "array", "items": { "type": "string" }, "description": "Discovery stage ids, e.g. S1_cpp." },
        "confirmed_by": { "type": "array", "items": { "type": "string" },
                          "description": "Checks that confirmed it, e.g. preprocess_equivalence, sanitizer_probe, build_probe, documentation." },
        "refuted_by": { "type": "array", "items": { "type": "string" } },
        "status": { "enum": ["hypothesis", "confirmed", "refuted"] },
        "notes": { "type": "string" }
      }
    },

    "setting": {
      "description": "One generation value of a boolean/enum/string option. 'token' is the ACTS-safe spelling.",
      "oneOf": [
        { "$ref": "#/$defs/scalar" },
        {
          "type": "object", "required": ["value"], "additionalProperties": false,
          "properties": {
            "value": { "$ref": "#/$defs/scalar" },
            "token": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
            "label": { "type": "string" },
            "rationale": { "type": "string" }
          }
        }
      ]
    },

    "partition": {
      "description": "Equivalence class of an integer option. Intervals are inclusive; 'min'/'max' refer to domain.range.",
      "type": "object",
      "required": ["label", "interval", "representative"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "interval": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": { "oneOf": [ { "type": "integer" }, { "enum": ["min", "max"] } ] }
        },
        "representative": { "type": "integer" },
        "rationale": { "type": "string" }
      }
    },

    "domain": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["boolean", "enum", "integer", "string"] },
        "values": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/setting" } },
        "range": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "min": { "type": "integer" },
            "max": { "type": "integer" },
            "evidence": { "type": "string" }
          }
        },
        "partitions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/partition" } },
        "rationale": { "type": "string" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "integer" } } },
          "then": { "required": ["range", "partitions", "rationale"] } },
        { "if": { "properties": { "type": { "enum": ["enum", "string"] } } },
          "then": { "required": ["values"] } },
        { "if": { "properties": { "type": { "const": "string" } } },
          "then": { "required": ["rationale"] } }
      ]
    },

    "apply": {
      "description": "How a setting is applied. c_macro => -D<macro>=<rendered value> (rebuild). driver_cli => '<flag> <value>' on the test driver command line. api_argument / env_var / config_file for other runtime mechanisms.",
      "type": "object",
      "required": ["mechanism"],
      "additionalProperties": false,
      "properties": {
        "mechanism": { "enum": ["c_macro", "cmake_option", "configure_flag", "driver_cli", "api_argument", "env_var", "config_file"] },
        "macro": { "type": "string" },
        "format": { "enum": ["int", "bool01", "c_string_literal", "raw"] },
        "flag": { "type": "string" },
        "variable": { "type": "string" }
      }
    },

    "option": {
      "type": "object",
      "required": ["name", "binding", "description", "domain", "default", "apply", "evidence"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "binding": { "enum": ["compile_time", "runtime"] },
        "description": { "type": "string" },
        "domain": { "$ref": "#/$defs/domain" },
        "default": { "$ref": "#/$defs/scalar" },
        "default_source": { "enum": ["code", "docs", "build_system", "convention"] },
        "active_when": { "$ref": "#/$defs/condition",
                         "description": "The option influences the system only when this holds; otherwise it is inert and equivalent to its default." },
        "apply": { "$ref": "#/$defs/apply" },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "provenance": { "$ref": "#/$defs/provenance" },
        "build_system_alias": { "type": "string" }
      },
      "allOf": [
        { "if": { "properties": { "binding": { "const": "compile_time" } } },
          "then": { "properties": { "apply": { "properties": { "mechanism": { "enum": ["c_macro", "cmake_option", "configure_flag"] } } } } } },
        { "if": { "properties": { "binding": { "const": "runtime" } } },
          "then": { "properties": { "apply": { "properties": { "mechanism": { "enum": ["driver_cli", "api_argument", "env_var", "config_file"] } } } } } }
      ]
    },

    "constraint": {
      "type": "object",
      "required": ["id", "kind", "expr", "rationale", "evidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["hard", "soft"] },
        "expr": { "$ref": "#/$defs/expression" },
        "origin": { "enum": ["documented", "code", "empirical", "llm"] },
        "status": { "enum": ["hypothesis", "confirmed", "refuted"] },
        "rationale": { "type": "string" },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },

    "interactionGroup": {
      "description": "Options that jointly control the same code (high-risk interaction candidates). Feeds ACTS [Relation] entries when suggested_strength exceeds the base strength.",
      "type": "object",
      "required": ["id", "options", "reason", "suggested_strength"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "options": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string" } },
        "reason": { "enum": ["shared_code", "nested_ifdef", "shared_condition", "shared_function", "documented"] },
        "region": { "type": "object", "additionalProperties": false,
                    "properties": { "file": { "type": "string" }, "lines": { "$ref": "#/$defs/lineSpec" } },
                    "description": "Shared code region; Phase 3/4 use it to check that a test actually executes the interaction." },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "suggested_strength": { "type": "integer", "minimum": 2, "maximum": 6 },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },

    "system": {
      "type": "object",
      "required": ["name", "repository", "commit", "language"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "repository": { "type": "string" },
        "commit": { "type": "string" },
        "commit_date": { "type": "string" },
        "language": { "type": "string" },
        "local_path": { "type": "string" },
        "sut_sources": { "type": "array", "items": { "type": "string" } },
        "extraction": { "type": "object" }
      }
    },

    "build": {
      "type": "object",
      "required": ["compiler", "library_sources"],
      "additionalProperties": false,
      "properties": {
        "compiler": { "type": "string" },
        "library_sources": { "type": "array", "items": { "type": "string" } },
        "include_dirs": { "type": "array", "items": { "type": "string" } },
        "cflags": { "type": "array", "items": { "type": "string" } },
        "coverage_cflags": { "type": "array", "items": { "type": "string" } },
        "sanitizer_cflags": { "type": "array", "items": { "type": "string" } },
        "coverage_sources": { "type": "array", "items": { "type": "string" } }
      }
    },

    "testSuite": {
      "type": "object",
      "required": ["drivers", "variants"],
      "additionalProperties": false,
      "properties": {
        "oracle": { "type": "string" },
        "working_directory": { "type": "string" },
        "input_files": { "type": "array", "items": { "type": "string" } },
        "case_delimiter_regex": { "type": "string" },
        "drivers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "source", "origin"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "source": { "type": "string" },
              "origin": { "enum": ["developer", "generated"] },
              "fixed_runtime": { "type": "object", "additionalProperties": { "$ref": "#/$defs/scalar" } },
              "accepts_runtime_options": { "type": "boolean" },
              "compatible_when": { "$ref": "#/$defs/condition" },
              "extra_link_sources_when": {
                "type": "array",
                "items": {
                  "type": "object", "required": ["when", "sources"], "additionalProperties": false,
                  "properties": { "when": { "$ref": "#/$defs/condition" },
                                  "sources": { "type": "array", "items": { "type": "string" } } }
                }
              },
              "args": { "type": "array", "items": { "type": "string" } },
              "baseline_proxy_for": { "type": "string" },
              "baseline_valid_when": { "$ref": "#/$defs/condition" },
              "notes": { "type": "string" }
            }
          }
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "driver", "settings", "baseline"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "driver": { "type": "string" },
              "settings": { "type": "object", "additionalProperties": { "$ref": "#/$defs/scalar" } },
              "baseline": { "type": "string" },
              "source_location": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
            }
          }
        }
      }
    }
  }
}
